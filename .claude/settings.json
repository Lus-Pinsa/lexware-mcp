{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh pr merge:*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__LU_S_Lexware__create-voucher",
      "mcp__LU_S_Lexware__update-voucher",
      "mcp__LU_S_Lexware__upload-voucher-file",
      "mcp__LU_S_Lexware__upload-file",
      "mcp__LU_S_Lexware__create-contact",
      "mcp__LU_S_Lexware__update-contact",
      "mcp__LU_S_Lexware__create-article",
      "mcp__LU_S_Lexware__update-article",
      "mcp__LU_S_Lexware__create-draft-invoice",
      "mcp__LU_S_Lexware__create-draft-quotation",
      "mcp__LU_S_Lexware__create-draft-credit-note",
      "mcp__LU_S_Lexware__create-draft-order-confirmation",
      "mcp__LU_S_Lexware__create-draft-delivery-note",
      "mcp__LU_S_Lexware__create-draft-dunning",
      "mcp__LU_S_Lexware__ensure-lus-voucher-webhook",
      "mcp__LU_S_Lexware__create-finalized-invoice",
      "mcp__LU_S_Lexware__create-finalized-quotation",
      "mcp__LU_S_Lexware__create-finalized-credit-note",
      "mcp__LU_S_Lexware__create-finalized-order-confirmation",
      "mcp__LU_S_Lexware__create-finalized-delivery-note",
      "mcp__LU_S_Lexware__create-finalized-dunning",
      "mcp__LU_S_Lexware__delete-article",
      "mcp__LU_S_Lexware__create-event-subscription",
      "mcp__LU_S_Lexware__delete-event-subscription"
    ],
    "ask": [
      "mcp__LU_S_Lexware__acknowledge-voucher-event"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
