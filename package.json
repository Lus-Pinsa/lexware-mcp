{
  "name": "lexware-mcp",
  "version": "0.1.7",
  "private": false,
  "license": "MIT",
  "description": "Open-source, self-hostable MCP server for the Lexware Office API",
  "type": "module",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "build": "tsc -b --force && node scripts/copy-persistence-migrations.mjs",
    "build:views": "skybridge build",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --force",
    "typecheck:governance": "tsc -p ai-company/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "node ai-company/scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jose": "^6.2.3",
    "pdf-parse": "2.4.5",
    "skybridge": "^1.2.4",
    "vite": "^8.1.3",
    "zod": "^4.4.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@skybridge/devtools": "^1.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  }
}
